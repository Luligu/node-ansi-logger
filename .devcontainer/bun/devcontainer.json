// .devcontainer/bun/devcontainer.json v.2.2.0

// This file defines the bun development container configuration for a Matterbridge project.

{
  // Name of the dev container
  "name": "Matterbridge Bun Dev Container",
  // Shared Matterbridge bun dev container image published on Docker Hub
  "image": "luligu/matterbridge:bun-dev-container",
  // Inherit timezone from the host environment (set TZ on the host, e.g. Europe/Paris)
  "containerEnv": {
    "TZ": "${localEnv:TZ}"
  },
  // Both the node and bun base images already use UID/GID 1000. Disabling the UID update avoids
  // VS Code creating a workspace-derived vsc-* image shared by both variants.
  "updateRemoteUserUID": false,
  // Use the non-root bun user (passwordless sudo in this image)
  "remoteUser": "bun",
  "mounts": [
    // Package specific volumes for bun node_modules, .cache to improve performance
    "source=${localWorkspaceFolderBasename}-bun-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localWorkspaceFolderBasename}-cache,target=${containerWorkspaceFolder}/.cache,type=volume",
    // Dev container shared volumes for vscode extensions, npm cache, bun cache, bash history, claude, codex, gemini and agents to improve performance
    // Shared with the node variant: both images create /home/<user>/.vscode-server/extensions owned by UID/GID 1000, so the volume seeds correctly for either
    "source=vscode-extensions,target=/home/bun/.vscode-server/extensions,type=volume",
    "source=npm-cache,target=/home/bun/.npm,type=volume",
    "source=bun-cache,target=/home/bun/.bun/install/cache,type=volume",
    "source=bash-cache,target=/home/bun/.bash-cache,type=volume",
    "source=claude,target=/home/bun/.claude,type=volume",
    "source=codex,target=/home/bun/.codex,type=volume",
    "source=gemini,target=/home/bun/.gemini,type=volume",
    "source=agents,target=/home/bun/.agents,type=volume"
  ],
  // Set up the Docker environment (runs on the host before the container starts).
  // Object form: entries run in parallel, each through the host shell (cmd.exe on Windows, /bin/sh elsewhere).
  // Deliberately uses only docker, so the host needs no node, bun or bash: the container is the only toolchain.
  // "||" is one of the few constructs both cmd.exe and /bin/sh share; docker network create is not idempotent,
  // hence the inspect first. On a host that has never created the network, the inspect logs a harmless
  // "network matterbridge not found" to stderr before it is created (there is no portable null device).
  // The pull is unconditional: it costs ~0.9s, runs in parallel with the network check, and guarantees the
  // image itself is never silently stale. Note that pulling refreshes the image, not an existing container:
  // a container keeps the image it was created from until you run "Dev Containers: Rebuild Container".
  "initializeCommand": {
    "network": "docker network inspect matterbridge --format ok || docker network create --ipv6 matterbridge",
    "pull": "docker pull luligu/matterbridge:bun-dev-container"
  },
  // On create, prepare directories, install dependencies, build the project and check outdated packages (runs inside the container)
  "postCreateCommand": "post-create.sh --bun",
  // On start, install and build the project (runs inside the container)
  "postStartCommand": "post-start.sh --bun",
  "runArgs": [
    // Give the Docker container the same name as the repository (must be unique on host)
    "--name",
    "${localWorkspaceFolderBasename}-bun",
    // OpenAI sandbox requisites (https://learn.chatgpt.com/docs/sandboxing?surface=cli)
    "--security-opt",
    "seccomp=unconfined",
    // Use network host mode if on Docker Engine on Linux or WSL 2 to allow full local network access and mDNS support
    // "--network=host"
    // Use a shared bridge network to allow to access other containers with their names (dns resolution). With the default bridge, dns resolution does not work (only ip:port).
    "--network=matterbridge"
  ],
  "customizations": {
    "vscode": {
      // Extensions to install in the dev container
      "extensions": [
        "typescriptteam.native-preview",
        "oxc.oxc-vscode",
        "vitest.explorer",
        "ms-azuretools.vscode-containers",
        "anthropic.claude-code",
        "github.copilot-chat",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "openai.chatgpt",
        "google.google-antigravity"
      ],
      // Settings for the VS Code environment specific to the dev container (overrides user and workspace settings)
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "oxc.useExecPath": true,
        "vitest.nodeExecutable": "/proc/self/exe"
      }
    }
  }
}
